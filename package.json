{
  "name": "panwatch-h5",
  "version": "0.1.0-h5",
  "private": true,
  "description": "盯盘侠 PanWatch 的移动端 H5 版本 · 莫兰迪配色 · 可部署到 Cloudflare Workers",
  "keywords": [
    "panwatch",
    "h5",
    "stock",
    "a-share",
    "cloudflare-workers",
    "morandi",
    "pwa"
  ],
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "verify:deploy": "wrangler deploy --dry-run",
    "preview": "node scripts/serve.mjs 5183",
    "icons": "python scripts/gen-icons.py",
    "og": "node scripts/gen-og.cjs",
    "set-origin": "node scripts/set-origin.cjs",
    "check": "node scripts/check.mjs",
    "audit:contrast": "node scripts/audit-contrast.mjs --md --json",
    "e2e": "node scripts/e2e.cjs",
    "e2e:design": "node scripts/e2e-design.cjs",
    "e2e:seo": "node scripts/e2e-seo.cjs",
    "verify": "node scripts/check.mjs && node scripts/audit-contrast.mjs && node scripts/e2e-seo.cjs && node scripts/e2e.cjs && node scripts/e2e-design.cjs"
  },
  "devDependencies": {
    "wrangler": "^4.137.0"
  },
  "engines": {
    "node": ">=18"
  }
}
