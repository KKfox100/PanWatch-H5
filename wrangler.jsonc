{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "panwatch-h5",
  "compatibility_date": "2026-09-01",

  // 纯静态站点：没有服务端逻辑，Workers 只负责把资源从边缘节点发出去。
  // directory 用 "." —— 项目根即站点根，index.html 直接对外。
  //
  // ⚠️ assets 配置里**没有** exclude 字段。想排除文件要用根目录的
  //    .assetsignore（.gitignore 语法），否则 wrangler 会把整个仓库
  //    ——包括 .git —— 一起上传。wrangler 对多余字段只警告不报错，
  //    很容易部署完才发现源码和版本历史都挂到了公网。
  "assets": {
    "directory": ".",
    "html_handling": "auto-trailing-slash",

    // 原本这里是 "single-page-application"，已改掉。
    //
    // 那个值会对任何未匹配的路径返回 200 + index.html。对**路径路由**的
    // SPA 这是必需的；但本项目是**哈希路由** —— 真实 URL 只有 `/` 与
    // `/design/index.html` 两个，`#/portfolio` 里的片段根本不发请求。
    //
    // 所以 SPA 回退在这里只会做一件事：把任意乱敲的地址（/abc、/x/y/z）
    // 全部变成「返回 200、内容与应用首页完全相同」的页面。搜索引擎会
    // 把它们当有效页面收录，形成无限个内容重复的软 404。
    "not_found_handling": "404-page"
  },

  "observability": { "enabled": true },

  "vars": {
    "APP_NAME": "PanWatch H5",
    "APP_VERSION": "0.1.0-h5"
  }
}
